# Generate with npm run password:hash. Do not commit real credentials.
OWNER_PASSWORD_HASH=
OWNER_NAME=Juan
DATABASE_PATH=data/studio.sqlite
HOST=127.0.0.1
PORT=3001
# Optional local two-model inference. All three paths must be supplied together.
# Use llama-completion from the official llama.cpp runtime. Paths are private and
# deployment-specific; model weights must stay outside git.
# ORBIT_LLM_BINARY=/absolute/path/to/llama-completion
# ORBIT_PRIMARY_MODEL=/absolute/path/to/Qwen3-4B-Q4_K_M.gguf
# ORBIT_REVIEW_MODEL=/absolute/path/to/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf
# ORBIT_LLM_THREADS=2
# ORBIT_LLM_RESERVE_MIB=1536
# ORBIT_LLM_SCRATCH=data/local-inference
# Production requires an exact HTTPS origin, with no trailing slash.
# PUBLIC_ORIGIN=https://your-domain.example
# NODE_ENV=production

# Optional paid beta. Use a least-privilege Stripe restricted key (rk_), never
# commit real values, and configure the webhook signing secret in Stripe.
# STRIPE_RESTRICTED_KEY=rk_test_REPLACE_IN_SECRET_STORE
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_IN_SECRET_STORE
# STRIPE_PRICE_OBSERVER=price_REPLACE
# STRIPE_PRICE_OPERATOR=price_REPLACE
# STRIPE_PRICE_DESK=price_REPLACE
# Quote Kit checkout is enabled only with Stripe test credentials and PUBLIC_ORIGIN.
# Register /api/quote-kit/webhook for checkout.session.completed and
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# and checkout.session.expired. Open /store/quote-kit to start.
QUOTE_KIT_STRIPE_TEST_KEY=
QUOTE_KIT_WEBHOOK_SECRET=
