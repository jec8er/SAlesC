# Generate with npm run password:hash. Do not commit real credentials.
OWNER_PASSWORD_HASH=
OWNER_NAME=Juan
DATABASE_PATH=data/studio.sqlite
HOST=127.0.0.1
PORT=3001
# Production requires an exact HTTPS origin, with no trailing slash.
# PUBLIC_ORIGIN=https://your-domain.example
# NODE_ENV=production

# Optional paid beta. Use a least-privilege Stripe restricted key (rk_), never
# commit real values, and configure the webhook signing secret in Stripe.
# STRIPE_RESTRICTED_KEY=rk_test_REPLACE_IN_SECRET_STORE
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_IN_SECRET_STORE
# STRIPE_PRICE_OBSERVER=price_REPLACE
# STRIPE_PRICE_OPERATOR=price_REPLACE
# STRIPE_PRICE_DESK=price_REPLACE
# Optional local Qwen-compatible adapter. Leave unset to keep agent proposals blocked.
QWEN_LOCAL_ENDPOINT=
QWEN_MODEL=
QWEN_API_KEY=
# Optional Ollama adapter. When set, Ollama takes precedence over Qwen.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_AUTO_DISCOVER=true
